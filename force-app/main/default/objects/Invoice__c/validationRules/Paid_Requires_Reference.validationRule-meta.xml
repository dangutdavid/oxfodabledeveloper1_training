<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Requires_Reference</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Paid"), ISBLANK(Payment_Reference__c))</errorConditionFormula>
    <errorMessage>An invoice cannot be marked Paid without the gateway payment reference.</errorMessage>
</ValidationRule>
